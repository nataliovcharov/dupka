# Copy to .env.prod on the server and fill in. Never commit .env.prod.
POSTGRES_USER=dupka
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=dupka
# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# the api's address, e.g. 1-2-3-4.sslip.io for the IP 1.2.3.4, or your own domain
API_DOMAIN=
# the frontend's address, as a JSON list
CORS_ORIGINS=["https://dupka.pages.dev"]
