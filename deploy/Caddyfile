# caddy gets and renews the https certificate for API_DOMAIN by itself
{$API_DOMAIN} {
	encode gzip

	# a bit above the api's own 10 MB limit, so the api gives the error
	request_body {
		max_size 12MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy api:8000
}
